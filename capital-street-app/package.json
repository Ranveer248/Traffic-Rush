{
  "name": "capital-street-app",
  "private": true,
  "version": "1.0.0",
  "description": "Capital Street for the App Store and Google Play: the game in ../capital-street wrapped with Capacitor.",
  "scripts": {
    "copy": "node copy-web.js",
    "sync": "node copy-web.js && cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "android": "node copy-web.js && cap sync android && cap open android",
    "ios": "node copy-web.js && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
